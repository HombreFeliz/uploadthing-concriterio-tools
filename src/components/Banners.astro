---
const banners = [
  {
    title: "¿Necesitas ayuda integrando esto en tu proyecto?",
    description:
      "Reserva una sesión de consultoría. Revisamos tu caso, resolvemos dudas y te dejo un plan claro.",
    cta: "Reservar sesión (30€)",
    href: "https://cal.com/polmarza/toma-de-contacto",
  },
  {
    title: "Cada semana, herramientas como esta en tu bandeja de entrada.",
    description:
      "La newsletter de Con Criterio: análisis técnico de herramientas útiles para desarrolladores.",
    cta: "Suscribirme",
    href: "https://concriterio.blog",
  },
  {
    title: "Esta demo está construida con Astro + React + UploadThing. El código es público.",
    description:
      "Explora el código fuente, haz fork, o úsalo como referencia para tu próximo proyecto.",
    cta: "Ver repositorio",
    href: "https://github.com/polmarza/uploadthing-concriterio-tools",
  },
];
---

<div class="space-y-3">
  {banners.map((banner) => (
    <div class="rounded-lg border border-[var(--color-border)] bg-[var(--color-surface)] p-6">
      <h3 class="text-[15px] font-semibold text-[var(--color-text)]">
        {banner.title}
      </h3>
      <p class="mt-1.5 text-sm text-[var(--color-text-muted)]">
        {banner.description}
      </p>
      <a
        href={banner.href}
        target="_blank"
        rel="noopener noreferrer"
        class="mt-4 inline-flex items-center rounded-md bg-[var(--color-primary)] px-4 py-2 text-sm font-medium text-white transition-colors duration-150 hover:bg-[var(--color-primary-hover)]"
      >
        {banner.cta}
      </a>
    </div>
  ))}
</div>

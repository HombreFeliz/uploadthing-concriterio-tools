---
const stack = [
  {
    name: "Astro 5",
    description: "Framework base con SSR. Renderiza HTML estático y solo hidrata los componentes React interactivos.",
  },
  {
    name: "React 19",
    description: "Islands para los componentes interactivos: uploader, galería y configurador.",
  },
  {
    name: "UploadThing",
    description: "SDK de uploads tipado. File Routes en el servidor, hooks en el cliente, CDN incluido.",
  },
  {
    name: "Tailwind CSS 4",
    description: "Utilidades CSS vía plugin Vite. Zero config, dark mode nativo.",
  },
  {
    name: "Vercel",
    description: "Deploy con adapter oficial de Astro. SSR en edge functions.",
  },
  {
    name: "TypeScript",
    description: "Tipado end-to-end desde el File Router del servidor hasta los componentes del cliente.",
  },
];
---

<section class="space-y-4">
  <h2 class="text-xl font-semibold tracking-tight">Stack</h2>
  <div class="overflow-hidden rounded-lg border border-[var(--color-border)] bg-[var(--color-surface)] divide-y divide-[var(--color-border)]">
    {stack.map((item) => (
      <div class="flex items-baseline gap-4 px-4 py-3">
        <p class="shrink-0 font-[var(--font-mono)] text-[13px] font-medium text-[var(--color-primary)]">
          {item.name}
        </p>
        <p class="text-sm text-[var(--color-text-muted)]">
          {item.description}
        </p>
      </div>
    ))}
  </div>
</section>
